document.addEventListener("DOMContentLoaded", function() {
    var wall = document.querySelector(".wall");
    var wallStyles = getComputedStyle(wall);
    var spider = document.querySelector(".spider");
    var wallWidth = wall.offsetWidth - parseInt(wallStyles.borderLeftWidth) - parseInt(wallStyles.borderRightWidth);
    var wallHeight = wall.offsetHeight - parseInt(wallStyles.borderTopWidth) - parseInt(wallStyles.borderBottomWidth);
    var topWall = wallHeight / 2 - spider.offsetHeight / 2;
    var leftWall = wallWidth / 2 - spider.offsetWidth / 2;
    wall.style.position = "relative";
    spider.style.position = "absolute";
    spider.style.top = "".concat(topWall, "px");
    spider.style.left = "".concat(leftWall, "px");
});

